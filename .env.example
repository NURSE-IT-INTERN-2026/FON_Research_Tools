DATABASE_URL="postgresql://postgres:postgres@localhost:5432/research_tools"

# Custom Auth (HMAC-SHA256 session tokens)
AUTH_SECRET=
AUTH_SESSION_VERSION="1"

# Admin Login (username/password) — hash must be bcrypt, base64-encoded for dotenvx compatibility
# Generate: echo -n '$(node -e "require('bcryptjs').hash('your-password',10).then(h=>console.log(h))")' | base64
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
# Toggle for the local username/password admin login. Default "true" keeps the fallback.
# Set to "false" in production once CMU OAuth is the canonical admin entry to remove the attack surface.
ADMIN_LOCAL_LOGIN_ENABLED="true"

# CMU OAuth 2.0
CLIENT_ID=
CLIENT_SECRET=
CMU_TENANT_ID=
CMU_GET_TOKEN=
CMU_BASIC_INFO=
SCOPE=
REDIRECT_URL=

# Email domain for constructing user emails (default: cmu.ac.th)
EMAIL_DOMAIN="cmu.ac.th"

# Placeholder email domain for students without CMU account (sync route)
PLACEHOLDER_EMAIL_DOMAIN="placeholder.cmu.ac.th"

# Thesis API
THESIS_API_URL=
THESIS_API_TOKEN=

# Email API (CMU)
EMAIL_API_BASE=
EMAIL_CLIENT_ID=
EMAIL_CLIENT_SECRET=
APP_URL=
EMAIL_SYSTEM_NAME="ResearchTool"

# Admin notification emails (used when DEV_NOTIFICATION_EMAIL is not set)
ADMIN_EMAIL_TO=
ADMIN_EMAIL_CC=

# Typhoon OCR
TYPHOON_BASE_URL=
TYPHOON_API_KEY=
TYPHOON_OCR_MODEL=typhoon-ocr

# Dev testing — must be OFF in production
# MOCK_THESIS: pull real thesis data from CMU Thesis API instead of mock.
MOCK_THESIS=true
# Used by dev login (DEV_STUDENT_USERNAME) and mock thesis. When set, dev login
# lands on this exact student. Otherwise falls back to a student with an email
# ending in @placeholder.cmu.ac.th. Never logs into a real student account.
DEV_TEST_STUDENT_ID=
DEV_FORCE_ROLE=
DEV_NOTIFICATION_EMAIL=
# Dev student login credentials — dev only (gated by NODE_ENV !== "production").
# Password hash must be bcrypt, base64-encoded (see ADMIN_PASSWORD_HASH above).
DEV_STUDENT_USERNAME=student
DEV_STUDENT_PASSWORD_HASH=

NEXT_PUBLIC_BASE_PATH="/researchtool"

# ---------------------------------------------------------------------------
# Production deployment checklist
# ---------------------------------------------------------------------------
# Before going live, verify these overrides in the production environment:
#   - ADMIN_LOCAL_LOGIN_ENABLED="false"   (use CMU OAuth as canonical admin entry)
#   - MOCK_THESIS="false"                  (real Thesis API data)
#   - DEV_STUDENT_USERNAME=                (clear — dev login is auto-gated by NODE_ENV, but unset to be safe)
#   - DEV_FORCE_ROLE=                      (clear)
#   - ADMIN_PASSWORD_HASH: rotate to a strong, randomly-generated password
#   - AUTH_SECRET: long, random, never reused across environments
#   - DATABASE_URL: production connection string, restricted IP if possible
#   - REDIRECT_URL + APP_URL: production domain (not ngrok URL)
#   - Run `npx tsx ngrok/production-cleanup.ts` once to wipe mock data first
