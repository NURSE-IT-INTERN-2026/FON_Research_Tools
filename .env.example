# ============================================================
# PRODUCTION ENVIRONMENT
# ============================================================
# Copy to `.env` for production deployment, then fill in real credentials.
# Dev-only vars (MOCK_THESIS, DEV_*) are NOT here — see `.env.local.example`.

# --- Database -------------------------------------------------------
# Production Postgres. Restrict by IP if possible.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB
DATABASE_URL=

# --- Auth (HMAC-SHA256 session tokens) ------------------------------
# Generate: openssl rand -base64 32
# Must be long, random, and NEVER reused across environments.
AUTH_SECRET=
# Bump this number to invalidate all existing sessions (forces everyone to re-login).
AUTH_SESSION_VERSION="1"

# --- Admin Login (username/password fallback) -----------------------
# Username for local admin login. Set in production only if you keep the fallback.
ADMIN_USERNAME=
# Bcrypt hash, base64-encoded. Generate:
#   echo -n "$(node -e "require('bcryptjs').hash('YOUR_PASSWORD',10).then(h=>console.log(h))")" | base64
ADMIN_PASSWORD_HASH=
# "false" = disable local admin login (CMU OAuth is the only admin entry — recommended).
# "true"  = keep username/password fallback (useful if OAuth breaks).
ADMIN_LOCAL_LOGIN_ENABLED="false"

# --- CMU OAuth 2.0 --------------------------------------------------
# Register at CMU IT to get these.
CLIENT_ID=
CLIENT_SECRET=
# Fixed for CMU tenant: cf81f1df-de59-4c29-91da-a2dfd04aa751
CMU_TENANT_ID=
# Token + user info endpoints (from CMU OAuth docs).
CMU_GET_TOKEN=
CMU_BASIC_INFO=
# Required scope — fixed value.
SCOPE=api://cmu/Mis.Account.Read.Me.Basicinfo
# MUST match the redirect URI registered with CMU OAuth.
# Production: https://YOUR_DOMAIN/researchtool/api/auth/callback
REDIRECT_URL=

# --- Email domain (for constructing user emails) --------------------
EMAIL_DOMAIN="cmu.ac.th"
# Used for students synced from Thesis API who don't have a CMU account.
PLACEHOLDER_EMAIL_DOMAIN="placeholder.cmu.ac.th"

# --- Thesis API (student thesis data) -------------------------------
THESIS_API_URL=
THESIS_API_TOKEN=

# --- CMU Email API (sending notifications) --------------------------
# Base URL of the nursing faculty email API.
EMAIL_API_BASE="https://mis.nurse.cmu.ac.th/thesis"
EMAIL_CLIENT_ID=
EMAIL_CLIENT_SECRET=
# Public URL of the deployed app — used in email links.
# Production: https://YOUR_DOMAIN/researchtool
APP_URL=
EMAIL_SYSTEM_NAME="ResearchTool"

# --- Admin notification recipients ----------------------------------
# Where system notifications get sent (new document uploads, etc.)
ADMIN_EMAIL_TO=
ADMIN_EMAIL_CC=

# --- Typhoon OCR ----------------------------------------------------
TYPHOON_BASE_URL=
TYPHOON_API_KEY=
TYPHOON_OCR_MODEL=typhoon-ocr

# --- App routing ----------------------------------------------------
NEXT_PUBLIC_BASE_PATH="/researchtool"

# ---------------------------------------------------------------------------
# Production checklist
# ---------------------------------------------------------------------------
# Before going live, verify:
#   - ADMIN_LOCAL_LOGIN_ENABLED="false"
#   - AUTH_SECRET: long, random, never reused across environments
#   - DATABASE_URL: production connection, restricted IP
#   - REDIRECT_URL + APP_URL: production domain (NOT localhost / ngrok)
#   - All DEV_* vars: unset in production (they live in .env.local for dev)
#   - Run `npx tsx ngrok/production-cleanup.ts` once to wipe mock data first
