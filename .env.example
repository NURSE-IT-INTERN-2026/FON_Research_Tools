DATABASE_URL="postgresql://postgres:postgres@localhost:5432/research_tools"

# Custom Auth (HMAC-SHA256 session tokens)
AUTH_SECRET=
AUTH_SESSION_VERSION="1"

# Admin Login (username/password) — hash must be bcrypt ($2a$10$...)
# Generate: npx bcryptjs hash "your-password"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# CMU OAuth 2.0
CLIENT_ID=
CLIENT_SECRET=
CMU_TENANT_ID=
CMU_GET_TOKEN=
CMU_BASIC_INFO=
SCOPE=
REDIRECT_URL=

# Thesis API
THESIS_API_URL=
THESIS_API_TOKEN=

# Email API (CMU)
EMAIL_API_BASE="https://mis.nurse.cmu.ac.th/thesis"
EMAIL_CLIENT_ID=
EMAIL_CLIENT_SECRET=
APP_URL="http://localhost:4141/researchtool"
EMAIL_SYSTEM_NAME="ResearchTool"

# Typhoon OCR
TYPHOON_BASE_URL=
TYPHOON_API_KEY=
TYPHOON_OCR_MODEL=typhoon-ocr

# Admin emails (legacy — no longer used, admin role is determined by DB)

# Dev testing
MOCK_THESIS=true
DEV_TEST_STUDENT_ID=
DEV_FORCE_ROLE=
DEV_NOTIFICATION_EMAIL=
DEV_STUDENT_USERNAME=student
DEV_STUDENT_PASSWORD_HASH=

NEXT_PUBLIC_BASE_PATH="/researchtool"
