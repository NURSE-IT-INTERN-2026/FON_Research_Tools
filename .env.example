DATABASE_URL="postgresql://postgres:postgres@localhost:5432/research_tools"

# Custom Auth (HMAC-SHA256 session tokens)
AUTH_SECRET=
AUTH_SESSION_VERSION="1"

# Admin Login (username/password) — hash must be bcrypt, base64-encoded for dotenvx compatibility
# Generate: echo -n '$(node -e "require('bcryptjs').hash('your-password',10).then(h=>console.log(h))")' | base64
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# CMU OAuth 2.0
CLIENT_ID=
CLIENT_SECRET=
CMU_TENANT_ID=
CMU_GET_TOKEN=
CMU_BASIC_INFO=
SCOPE=
REDIRECT_URL=

# Email domain for constructing user emails (default: cmu.ac.th)
EMAIL_DOMAIN="cmu.ac.th"

# Placeholder email domain for students without CMU account (sync route)
PLACEHOLDER_EMAIL_DOMAIN="placeholder.cmu.ac.th"

# Thesis API
THESIS_API_URL=
THESIS_API_TOKEN=

# Email API (CMU)
EMAIL_API_BASE=
EMAIL_CLIENT_ID=
EMAIL_CLIENT_SECRET=
APP_URL=
EMAIL_SYSTEM_NAME="ResearchTool"

# Admin notification emails (used when DEV_NOTIFICATION_EMAIL is not set)
ADMIN_EMAIL_TO=
ADMIN_EMAIL_CC=

# Typhoon OCR
TYPHOON_BASE_URL=
TYPHOON_API_KEY=
TYPHOON_OCR_MODEL=typhoon-ocr

# Dev testing
MOCK_THESIS=true
DEV_TEST_STUDENT_ID=
DEV_FORCE_ROLE=
DEV_NOTIFICATION_EMAIL=
DEV_STUDENT_USERNAME=student
DEV_STUDENT_PASSWORD_HASH=

NEXT_PUBLIC_BASE_PATH="/researchtool"
