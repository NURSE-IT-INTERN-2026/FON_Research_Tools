generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

enum AppRole {
  ADMIN
  STUDENT
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ActivityAction {
  USER_LOGIN
  DOCUMENT_UPLOAD
  DOCUMENT_APPROVE
  DOCUMENT_REJECT
  DOCUMENT_REMOVE
  ADMIN_CREATED
  BORROW_SUBMIT
  BORROW_REMOVE
}

model Profile {
  id           String    @id
  name         String
  email        String    @unique
  studentId    String?   @unique
  cmuItAccount String?
  role         AppRole   @default(STUDENT)
  thesisTitleTh String?
  thesisTitleEn String?
  level        String?
  borrowCount  Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  documents        Document[]
  borrowingRecords BorrowingRecord[]
  createdBorrows   BorrowingRecord[] @relation("CreatedBy")
  activityLogs     ActivityLog[]
}

model Document {
  id           String         @id @default(cuid())
  userId       String
  title        String
  fileName     String
  originalName String
  fileSize     Int
  status       DocumentStatus @default(PENDING)
  reviewedBy   String?
  reviewedAt   DateTime?
  adminNotes   String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model ActivityLog {
  id          String         @id @default(cuid())
  action      ActivityAction
  userId      String
  targetType  String?
  targetId    String?
  targetLabel String?
  metadata    String?
  createdAt   DateTime       @default(now())

  profile     Profile        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([action])
  @@index([targetType])
  @@index([userId])
  @@index([createdAt])
}

model BorrowingRecord {
  id                      String    @id @default(cuid())
  ownerUserId             String
  requesterName           String
  requestDate             DateTime?
  source                  String?
  additionalDetails       String?
  licenseFileName         String?
  licenseOriginalName     String?
  licenseFileSize         Int?
  certificateFileName     String?
  certificateOriginalName String?
  certificateFileSize     Int?
  createdBy               String
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  owner     Profile @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  creator   Profile @relation("CreatedBy", fields: [createdBy], references: [id])

  @@index([ownerUserId])
  @@index([createdAt])
}
