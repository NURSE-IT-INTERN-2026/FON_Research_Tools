# ============================================================
# LOCAL DEVELOPMENT
# ============================================================
# Copy to `.env.local` (gitignored). Values here OVERRIDE `.env`.
#
# Workflow:
#   1. cp .env.example       .env        # production-like base config
#   2. cp .env.local.example .env.local  # dev overrides (this file)
#   3. Fill in real secrets in BOTH files
#
# All DEV_* vars are gated by NODE_ENV !== "production" — safe to keep here.

# ============================================================
# Local overrides for production-like vars
# ============================================================

# Local Postgres (default Docker/local install)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/research_tools"

# Bump to invalidate dev sessions (independent from production)
AUTH_SESSION_VERSION="2"

# Dev server: port 4141, basePath /researchtool
REDIRECT_URL=http://localhost:4141/researchtool/api/auth/callback
APP_URL="http://localhost:4141/researchtool"

# Enable local admin login (username/password) for dev convenience
ADMIN_LOCAL_LOGIN_ENABLED="true"
ADMIN_USERNAME=admin
# Bcrypt hash, base64-encoded — see .env.example for generation command.
# Leave empty to use CMU OAuth only.
ADMIN_PASSWORD_HASH=

# Project admin recipients (same in dev and prod)
ADMIN_EMAIL_TO=supapan.ch@cmu.ac.th
ADMIN_EMAIL_CC=ampika.s@cmu.ac.th

# ============================================================
# Dev-only vars (NEVER set these in production)
# ============================================================

# Mock thesis data instead of calling real Thesis API (faster dev, no API quota use)
# MOCK_THESIS=true

# Student ID used by:
#   - Mock thesis (overrides returned student_id when MOCK_THESIS=true)
#   - Dev student login (DEV_STUDENT_USERNAME) — lands on this exact student
DEV_TEST_STUDENT_ID=621251008

# Force role on CMU OAuth login — bypasses faculty check, alumni check, admin DB.
# Uncomment ONE to test role-specific UI without logging in as a real account.
# DEV_FORCE_ROLE=ADMIN
# DEV_FORCE_ROLE=STUDENT

# Override where dev emails are sent — PREVENTS sending real emails to real users.
# Strongly recommended when testing email flows locally.
# DEV_NOTIFICATION_EMAIL=your-email@example.com

# Dev student login (separate from ADMIN_USERNAME). Bcrypt hash, base64-encoded.
DEV_STUDENT_USERNAME=student
DEV_STUDENT_PASSWORD_HASH=
